# Production mode enables secure session cookies and requires explicit secrets.
IPC_ENV=production

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
IPC_SECRET_KEY=replace-with-a-long-random-secret

# Keep this as 1 behind HTTPS. The standalone Windows LAN launcher sets it to 0
# because it is reached through a private-network http://IP:5000 address.
IPC_SECURE_COOKIES=1

# Used only when the production database has no users yet.
IPC_INITIAL_ADMIN_NAME=admin
IPC_INITIAL_ADMIN_EMAIL=admin@example.local
IPC_INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password

# Point these paths to the hosting provider's persistent disk.
IPC_DB_PATH=/data/ipc.db
IPC_UPLOAD_DIR=/data/uploads
IPC_BACKUP_DIR=/data/backups
IPC_IMPORT_TMP_DIR=/tmp/ipc-imports

# Optional shared parent directory and Windows LAN port.
IPC_DATA_DIR=/data
IPC_PORT=5000
